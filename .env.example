# ── AI Provider ──────────────────────────────────────────────────────────────
# Get your key at https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=your_key_here

# ── Server Ports ─────────────────────────────────────────────────────────────
FRONTEND_PORT=3000
BACKEND_PORT=3001

# ── Backend Config (optional) ────────────────────────────────────────────────
# Path to the HR policy markdown file (relative to backend/)
KB_PATH=../data/knowledge_base.md

# Claude model to use — options: claude-opus-4-7, claude-sonnet-4-6, claude-haiku-4-5-20251001
CLAUDE_MODEL=claude-sonnet-4-6

# Comma-separated list of allowed frontend origins for CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
