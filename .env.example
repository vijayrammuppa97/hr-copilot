# ── Ollama (local LLM — no API key needed) ───────────────────────────────────
# Install Ollama: https://ollama.com/download
# Then pull a model: ollama pull llama3.2

# Model to use (must be pulled first via: ollama pull <model>)
# Options: llama3.2 | phi3:mini | mistral | llama3.1
OLLAMA_MODEL=llama3.2

# Ollama server address (default — don't change unless you moved it)
OLLAMA_HOST=http://localhost:11434

# ── Backend Config ────────────────────────────────────────────────────────────
# Path to the HR policy markdown file (relative to backend/)
KB_PATH=../data/knowledge_base.md

# Comma-separated list of allowed frontend origins for CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
